# 必填：百炼 API Key（只在本机配置，不要提交）
DASHSCOPE_API_KEY=
# 可选：百炼业务空间；如果不填，DashScope SDK 使用默认公网 API 地址
BAILIAN_WORKSPACE_ID=
BAILIAN_REGION=cn-beijing
BAILIAN_VL_MODEL=qwen3-vl-32b-instruct
# 可选：百炼官方或自定义 Streamable HTTP MCP 地址和工具名
BAILIAN_MCP_URL=
BAILIAN_MCP_TOOL=web_search

# 可选：团队维护的真实产品 JSON 资料库
PRODUCT_KB_PATH=
